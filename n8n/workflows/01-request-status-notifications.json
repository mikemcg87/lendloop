              "value": "={{ JSON.stringify({ requestId: $('Webhook').item.json.body.requestId, kind: 'notification_sent', key: $('Webhook').item.json.body.eventId, status: $('Webhook').item.json.body.event }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
