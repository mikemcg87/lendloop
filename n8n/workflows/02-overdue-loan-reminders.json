      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "fieldToSplitOut": "loans",
        "options": {}
      },
      "id": "7a2c9d10-3b4e-4f61-8a2b-9e0d1c2b3a06",
      "name": "One item per loan",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9e0d1c2b-0002-4f61-8a2b-7a2c9d103b4e",
              "name": "timestamp",
              "value": "={{ Date.now().toString() }}",
              "type": "string"
            },
            {
              "id": "9e0d1c2b-0003-4f61-8a2b-7a2c9d103b4e",
              "name": "rawBody",
              "value": "={{ JSON.stringify({ requestId: $json.requestId, runDate: $json.runDate }) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7a2c9d10-3b4e-4f61-8a2b-9e0d1c2b3a07",
      "name": "Build claim",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1320,
        0
