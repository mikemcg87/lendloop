{
  "id": "lendloopErrors01",
  "name": "LendLoop: Error handler",
  "nodes": [
    {
      "parameters": {},
      "id": "3d4e5f60-1a2b-4c3d-9e8f-0a1b2c3d4e01",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_ALERT_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: `LendLoop workflow \"${$json.workflow.name}\" failed at node \"${$json.execution?.lastNodeExecuted ?? 'unknown'}\": ${$json.execution?.error?.message ?? $json.trigger?.error?.message ?? 'no message'}`, executionUrl: $json.execution?.url ?? null }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "3d4e5f60-1a2b-4c3d-9e8f-0a1b2c3d4e02",
      "name": "Alert operator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Alert operator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
