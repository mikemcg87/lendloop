# Shared HMAC secret. Must equal the Convex deployment's N8N_WEBHOOK_SECRET.
# Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Convex HTTP actions URL as seen from inside the n8n container.
# Local `convex dev` backend:  http://host.docker.internal:3211
# Cloud deployment:            https://<deployment-name>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Where notifications and failure alerts are POSTed as JSON. Defaults to the
# bundled mock sink; point these at a Slack incoming webhook to go live.
# LENDLOOP_NOTIFY_SINK_URL=
# LENDLOOP_ALERT_URL=

# Notification channel: "mock" (default, logged by the bundled sink) or "ses"
# (real email through Amazon SES). For "ses", also set the verified sender
# address and import n8n/credentials.json (see docs/REFERENCE.md).
# LENDLOOP_NOTIFY_CHANNEL=ses
# LENDLOOP_SES_FROM=you@example.com
