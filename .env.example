# --- Next.js (.env.local) ---------------------------------------------------
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex deployment (set with `npx convex env set NAME value`) ------------
# These are NOT read from .env.local; they live on the Convex deployment.
#
# CLERK_JWT_ISSUER_DOMAIN   Issuer of the Clerk "convex" JWT template,
#                           e.g. https://your-app.clerk.accounts.dev
# N8N_NOTIFY_WEBHOOK_URL    Production URL of the n8n notification webhook.
# N8N_WEBHOOK_SECRET        Shared HMAC secret for Convex <-> n8n requests.
#                           Generate with: openssl rand -hex 32
